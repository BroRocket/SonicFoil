{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SonicFoil",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-g",
                "backend/main.cpp",
                "backend/Airfoil/airfoil.cpp",
                "backend/Analysis/oblique_shock.cpp",
                "backend/Analysis/oblique_expansion.cpp",
                "backend/Analysis/hess_smith.cpp",
                "backend/Analysis/XfoilWrapper.cpp",
                "backend/Solvers/aerodynamic_forces.cpp",
                "backend/Solvers/solver.cpp",
                "backend/Tools/matrix.cpp",
                "-I", "backend",
                "-o",
                "main.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
