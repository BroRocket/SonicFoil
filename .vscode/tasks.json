{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: test_matrix",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-O2",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "${workspaceFolder}/backend/Tools/test_matrix.cpp",
        "${workspaceFolder}/backend/Tools/matrix.cpp",
        "-o",
        "${workspaceFolder}/backend/Tools/test_matrix"
      ],
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },

      "windows": {
        "command": "g++",
        "args": [
          "-std=c++17",
          "-O2",
          "-Wall",
          "-Wextra",
          "-pedantic",
          "${workspaceFolder}\\backend\\Tools\\test_matrix.cpp",
          "${workspaceFolder}\\backend\\Tools\\matrix.cpp",
          "-o",
          "${workspaceFolder}\\backend\\Tools\\test_matrix.exe"
        ]
      }
    },
    {
      "label": "run: test_matrix",
      "type": "shell",
      "dependsOn": "build: test_matrix",
      "command": "${workspaceFolder}/backend/Tools/test_matrix",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\backend\\Tools\\test_matrix.exe"
      }
    }
  ]
}